# Local source package; no AUR upload or installation is performed automatically.
# From the repository root:
#   tar --exclude=target --exclude=.git -czf /tmp/vibeterm-0.1.0.tar.gz .
#   cp packaging/PKGBUILD /tmp/PKGBUILD
#   cd /tmp && makepkg -sf
pkgname=vibeterm
pkgver=0.1.0
pkgrel=1
pkgdesc='Native GPU terminal for Linux (early single-pane release)'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('gcc-libs' 'glibc' 'fontconfig' 'libxkbcommon' 'wayland' 'libx11' 'libxcursor' 'libxi' 'libxrandr' 'vulkan-icd-loader')
makedepends=('rust' 'pkgconf')
optdepends=('vulkan-driver: hardware-accelerated rendering' 'mesa: OpenGL fallback' 'ttf-dejavu: monospace font')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP') # Local, unpublished source archive; pin a digest before distribution.

prepare() {
  cargo fetch --locked
}

build() {
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --release --locked --offline
}

check() {
  cargo test --locked --offline
}

package() {
  install -Dm755 target/release/vibeterm "$pkgdir/usr/bin/vibeterm"
  install -Dm644 packaging/vibeterm.desktop "$pkgdir/usr/share/applications/vibeterm.desktop"
  install -Dm644 packaging/vibeterm.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/vibeterm.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/vibeterm/LICENSE"
  install -Dm644 config.example.toml "$pkgdir/usr/share/doc/vibeterm/config.example.toml"
  install -Dm644 README.md "$pkgdir/usr/share/doc/vibeterm/README.md"
}
